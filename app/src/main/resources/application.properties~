spring.application.name=portal-scripts
spring.main.banner-mode=off

# Portal connection — sobrescreva via env vars PORTAL_URL, PORTAL_API_KEY e PORTAL_HISTORY_FILE
portal.url=${PORTAL_URL:http://localhost:8088}
portal.api-key=${PORTAL_API_KEY:gateway-default-api-key-2025}
portal.timeout-seconds=30

# History file (caminho relativo ao diretório de execução)
portal.history-file=${PORTAL_HISTORY_FILE:portal_scripts_history.json}

# Logging
logging.config=classpath:logback-spring.xml
server.port=8032