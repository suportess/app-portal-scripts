    "chave": "cadastrar-produto",
    "descricao": "Cadastra produto no MV (v10): corrige DS_PRO_FAT NOT NULL (fallback para ds_produto) e CD_PRO_FAT prefix '09' para suportar sequencias ate 999999.",
    "tipo": "ANONYMOUS",
    "tipoBanco": "oracle",
    "sql": "DECLARE v_cnt NUMBER; v_cd_produto NUMBER; v_cd_itunidade NUMBER; v_nm_unidade VARCHAR2(60); v_cd_pro_fat VARCHAR2(14); BEGIN DBAMV.PKG_MV2000.ATRIBUI_EMPRESA(1); SELECT COUNT(*) INTO v_cnt FROM DBAMV.SUB_CLAS WHERE CD_CLASSE = :cd_classe AND CD_ESPECIE = :cd_especie AND CD_SUB_CLA = :cd_sub_cla; IF v_cnt = 0 THEN INSERT INTO DBAMV.SUB_CLAS (CD_CLASSE, CD_ESPECIE, CD_SUB_CLA, DS_SUB_CLA, SN_SAIDA_PACIENTE, SN_SAIDA_CC, SN_CUSTO_DIRETO, SN_PROD_PERMANENTE, SN_TRANSFERE, SN_ATIVO, SN_SOL_PRESCRICAO) VALUES (:cd_classe, :cd_especie, :cd_sub_cla, :ds_sub_cla, 'S', 'S', 'N', 'N', 'S', 'S', 'N'); END IF; v_cd_produto := DBAMV.SEQ_PRODUTO.NEXTVAL; IF :cd_pro_fat IS NULL OR TRIM(:cd_pro_fat) IS NULL THEN v_cd_pro_fat := '090' || TO_CHAR(v_cd_produto); INSERT INTO DBAMV.PRO_FAT (CD_PRO_FAT, DS_PRO_FAT, DS_UNIDADE, TP_SEXO, CD_GRU_PRO, SN_PACOTE, SN_ATIVO, SN_URGENCIA, SN_PODE_PERM_MAIOR, SN_PODE_SD, SN_FIDEPS, SN_CD_SUS_AUXILIAR, SN_PERTENCE_PACOTE_SUS, SN_CONTRASTE, SN_PODE_SER_AUTORIZADO, SN_ATO_ANESTESICO, SN_BUSCA_ATIVA_PAC_OBITO, SN_OBRIGA_VDRL, SN_PERMITE_ALTA_DA_UTI, SN_GERA_MATRICULA_SAME, SN_LANCA_PRO_FAT_ATEND, SN_CALCULA_VALOR, SN_PARTO, SN_DIARIA_UTI_RN, SN_OPME) VALUES (v_cd_pro_fat, NVL(SUBSTR(:ds_pro_fat, 1, 60), SUBSTR(:ds_produto, 1, 60)), 'UN', 'A', 8, 'N', 'S', 'N', 'N', 'S', 'N', 'N', 'N', 'N', 'S', 'N', 'N', 'N', 'N', 'N', 'N', 'S', 'N', 'N', NVL(:sn_opme, 'N')); ELSE v_cd_pro_fat := :cd_pro_fat; END IF; INSERT INTO DBAMV.PRODUTO (CD_PRODUTO, CD_SUB_CLA, CD_CLASSE, CD_ESPECIE, DS_PRODUTO, DS_PRODUTO_RESUMIDO, DS_COMERCIAL, DS_ESPECIFICACAO, DT_CADASTRO, TP_ATIVO, TP_STATUS_UNIFICADO, TP_SEXO, SN_LOTE, SN_CONTROLE_VALIDADE, SN_MEDICAMENTO, SN_CONSIGNADO, SN_MOVIMENTACAO, SN_PADRONIZADO, SN_BLOQUEIO_DE_COMPRA, SN_PSCOTROPICO, SN_ACONDICIONADO, SN_IMPRIME_ETIQUETA, SN_KIT, SN_MESTRE, SN_INVASIVO, SN_OPME, SN_BLOQUEIO_SOL_ORD_COMPRA, SN_MARCA_OBRIGATORIA, SN_CONTROLA_SERIE, TP_CLASSIFICACAO_TRIBUTARIA, TP_CALCULO_MEDIA_PONDERADA, CD_TIP_ATIV, CD_PRO_FAT, CD_PRO_FAT_SUS, CD_PROCEDIMENTO_SUS, CD_FORNECEDOR_PRINCIPAL, CD_SICAN, VL_FATOR_PRO_FAT) VALUES (v_cd_produto, :cd_sub_cla, :cd_classe, :cd_especie, :ds_produto, SUBSTR(:ds_produto, 1, 40), :ds_comercial, :ds_especificacao, SYSDATE, 'S', 'A', :tp_sexo, :sn_lote, :sn_validade, :sn_medicamento, :sn_consignado, 'S', 'N', 'N', 'N', 'N', 'S', 'N', 'N', 'N', :sn_opme, 'N', 'N', 'N', 'T', 'M', :cd_tip_ativ, v_cd_pro_fat, :cd_pro_fat_sus, :cd_procedimento_sus, :cd_fornecedor_principal, :cd_sican, 1); SELECT CD_ITUNIDADE, NM_ITUNIDADE INTO v_cd_itunidade, v_nm_unidade FROM DBAMV.ITUNIDADE WHERE CD_UNIDADE = :cd_unidade AND ROWNUM = 1; INSERT INTO DBAMV.UNI_PRO (CD_UNI_PRO, CD_PRODUTO, CD_UNIDADE, DS_UNIDADE, VL_FATOR, TP_RELATORIOS, SN_ATIVO, SN_PRESCRICAO, CD_ITUNIDADE) VALUES (DBAMV.SEQ_UNI_PRO.NEXTVAL, v_cd_produto, :cd_unidade, v_nm_unidade, 1, 'R', 'S', 'S', v_cd_itunidade); FOR e IN (SELECT empresa FROM JSON_TABLE(:empresas_json, '$[*]' COLUMNS (empresa NUMBER PATH '$'))) LOOP INSERT INTO DBAMV.EMPRESA_PRODUTO (CD_PRODUTO, CD_MULTI_EMPRESA, QT_ESTOQUE_ATUAL, QT_ESTOQUE_MINIMO, QT_ESTOQUE_MAXIMO, QT_PONTO_DE_PEDIDO, QT_CONSUMO_MES, VL_CUSTO_MEDIO, VL_MARGEM_LUCRO, VL_PRECO_DE_VENDA, SN_ATIVO, SN_PADRONIZADO, SN_LOTE, SN_CONTROLE_VALIDADE, SN_BLOQUEIO_DE_COMPRA, SN_MOVIMENTACAO) VALUES (v_cd_produto, e.empresa, 0, 0, 0, 0, 0, 0, 0, 0, 'S', 'N', :sn_lote, :sn_validade, 'N', 'S'); END LOOP; COMMIT; :cd_produto_out := v_cd_produto; END;",
