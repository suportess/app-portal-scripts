{
    "_type":  "export",
    "__export_format":  4,
    "__export_date":  "2026-05-03",
    "__export_source":  "portal-scripts",
    "resources":  [
                      {
                          "_id":  "wrk_portal_dbamv",
                          "_type":  "workspace",
                          "name":  "Portal DBAMV",
                          "description":  "Rotas geradas via portal-scripts â€” API sobre o banco DBAMV (Oracle MV)"
                      },
                      {
                          "_id":  "env_base",
                          "_type":  "environment",
                          "parentId":  "wrk_portal_dbamv",
                          "name":  "Base",
                          "data":  {
                                       "base_url":  "http://localhost:8088",
                                       "api_key":  "uuuuuuuuuuu"
                                   }
                      },
                      {
                          "_id":  "fld_mv",
                          "_type":  "request_group",
                          "parentId":  "wrk_portal_dbamv",
                          "name":  "MV"
                      },
                      {
                          "_id":  "req_get_multiempresas",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Listar Multi Empresas",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/multiempresas",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ]
                      },
                      {
                          "_id":  "req_get_estoques_consignados",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Estoques com Consignados por Empresa",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/multiempresas/1/estoques",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ],
                          "parameters":  [
                                             {
                                                 "name":  "page",
                                                 "value":  "1"
                                             },
                                             {
                                                 "name":  "pageSize",
                                                 "value":  "20"
                                             }
                                         ]
                      },
                      {
                          "_id":  "req_get_produtos_consignados",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Produtos Consignados por Empresa e Estoque",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/multiempresas/1/estoques/1/produtos",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ],
                          "parameters":  [
                                             {
                                                 "name":  "page",
                                                 "value":  "1"
                                             },
                                             {
                                                 "name":  "pageSize",
                                                 "value":  "20"
                                             }
                                         ]
                      },
                      {
                          "_id":  "req_get_saldo_lote_produto",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Saldo em Lote de Produto por Estoque",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/estoques/45/produtos/5887/saldo-lote",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ]
                      },
                      {
                          "_id":  "req_get_entradas_por_produto",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Entradas por Produto e Estoque",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/estoques/45/produtos/5887/entradas",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ],
                          "parameters":  [
                                             {
                                                 "name":  "page",
                                                 "value":  "1"
                                             },
                                             {
                                                 "name":  "pageSize",
                                                 "value":  "20"
                                             }
                                         ]
                      },
                      {
                          "_id":  "req_post_devolver_produto_consignado",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Devolver Produto Consignado",
                          "method":  "POST",
                          "url":  "{{ _.base_url }}/mv/api/estoques/45/devolucoes",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          },
                                          {
                                              "name":  "Content-Type",
                                              "value":  "application/json"
                                          }
                                      ],
                          "body":  {
                                       "mimeType":  "application/json",
                                       "text":  "{\"cd_multi_empresa\":1,\"cd_ent_pro\":123456,\"cd_produto_dev\":5887,\"cd_lote_dev\":null,\"dt_validade_dev\":null,\"qt_devolvida\":10,\"cd_produto_ent\":5907,\"cd_lote_ent\":null,\"dt_validade_ent\":null,\"qt_entrada\":10,\"dt_devolucao\":\"2026-05-03\"}"
                                   }
                      },
                      {
                          "_id":  "req_get_produto_detalhe",
                          "_type":  "request",
                          "parentId":  "fld_mv",
                          "name":  "Detalhe do Produto (lote/validade)",
                          "method":  "GET",
                          "url":  "{{ _.base_url }}/mv/api/produtos/5887",
                          "headers":  [
                                          {
                                              "name":  "X-API-KEY",
                                              "value":  "{{ _.api_key }}"
                                          }
                                      ]
                      }
                  ]
}